# ─────────────────────────────────────────────────────────────────
#  Salasel - Environment Variables
#  Copy to .env — never commit .env to git
# ─────────────────────────────────────────────────────────────────

# Docker image (set by CI/CD — don't change manually on VPS)
DOCKER_IMAGE=abdelrahmansaeed369/salasel-api
IMAGE_TAG=latest

# Database
DB_NAME=SalaselDb
DB_PASSWORD=Your_Secure_Database_Password_Here

# JWT
JWT_KEY=Your_Super_Secret_JWT_Key_Here
